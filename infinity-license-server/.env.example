# ===== Infinity License Server =====
PORT=8787
APP_URL=https://infinitycod.pro
API_URL=https://infinitycod.pro/api/v1
# Base de données : fichier SQLite (par défaut, zéro config).
# DB_PATH=/var/lib/infinity-license/infinity-license.db
STORAGE_PATH=/var/lib/infinity-license

# Secrets — GÉNÉRER des valeurs uniques (openssl rand -base64 32)
APP_KEY=
SESSION_SECRET=

# Clés de signature Ed25519 — auto-générées dans storage/keys au premier
# démarrage si absentes. En production, monter storage/ comme volume.
# LICENSE_PRIVATE_KEY=
# LICENSE_PUBLIC_KEY=

# SMTP (optionnel — sinon les emails sont journalisés dans email_logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=licenses@infinitycod.pro

# GitHub (intégration releases, optionnel)
GITHUB_TOKEN=

# Webhook Freemius — token secret dans l'URL du webhook
# (https://…/api/webhooks/freemius?token=…) — OBLIGATOIRE pour activer l'endpoint.
# FREEMIUS_WEBHOOK_TOKEN=
# Vérification additionnelle de l'en-tête x-signature (HMAC-SHA256 hex du corps)
# quand Freemius l'envoie. Optionnel.
# FREEMIUS_WEBHOOK_SECRET=
